# Copy to .env.local after registering a Web App in Firebase Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development only. Set to true to connect to Firebase emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# Server-only AI credentials. Never prefix these with NEXT_PUBLIC_.
SERENITY_DEEPSEEK_API_KEY=
SERENITY_OPENAI_API_KEY=
SERENITY_GEMINI_API_KEY=

# Firebase Admin runtime credentials for AI token verification, workspace membership, and persistent rate limits.
# Required on non-Google hosting; Google-hosted deployments may use Application Default Credentials instead.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
